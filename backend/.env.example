PORT=5000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pg_manager
DB_USER=postgres
DB_PASSWORD=your_password
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d
# One or more origins, comma separated
FRONTEND_URL=http://localhost:5173
# Production only (used by `npm run migrate` on a fresh install)
MASTER_ADMIN_EMAIL=niru@gmail.com
MASTER_ADMIN_PASSWORD=123456
